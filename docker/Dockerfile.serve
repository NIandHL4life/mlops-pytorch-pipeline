# ==========================================
# Production Model Serving Image
# ==========================================
FROM python:3.11-slim AS runtime

WORKDIR /app

# Prevent Python from writing .pyc files and buffering stdout
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PORT=8080

# Install curl for HEALTHCHECK and required runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy and install only inference dependencies
COPY requirements/serve.txt .
RUN pip install --no-cache-dir -r serve.txt

# Copy application source code
COPY src/ ./src/

# Create app directory & non-root user for security best practices
RUN mkdir -p /app/checkpoints /app/data && \
    useradd -u 1000 -m -s /bin/bash appuser && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# Expose model serving port
EXPOSE 8080

ENV PYTHONPATH=/app/src

# Healthcheck probe for Docker container lifecycle
HEALTHCHECK --interval=10s --timeout=3s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Start FastAPI server via uvicorn
ENTRYPOINT ["uvicorn", "src.serve:app", "--host", "0.0.0.0", "--port", "8080"]
