# ==========================================
# Stage 1: Base with dependencies
# ==========================================
FROM python:3.11-slim AS base

WORKDIR /app

# Prevent Python from writing .pyc files and buffer stdout/stderr
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Install system dependencies if required for PyTorch/torchvision
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy and install pinned requirements
COPY requirements/train.txt .
RUN pip install --no-cache-dir -r train.txt

# ==========================================
# Stage 2: Training runtime
# ==========================================
FROM base AS training

WORKDIR /app

# Copy application source code and default configs
COPY src/ ./src/
COPY configs/ ./configs/

# Create mount points for data and checkpoints
RUN mkdir -p /app/data /app/checkpoints

ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1

ENTRYPOINT ["python", "src/train.py"]
